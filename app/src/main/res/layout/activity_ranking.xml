<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:background="#F8F9FA">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🏆 Ranking Geral"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#212529"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp" />

    <!-- Container da Lista de Melhores -->
    <LinearLayout
        android:id="@+id/containerRanking"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginBottom="40dp" />

    <Button
        android:id="@+id/btnResponderNovamente"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="RESPONDER NOVAMENTE"
        android:textStyle="bold"
        android:backgroundTint="#4F46E5"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnTelaPrincipal"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="TELA PRINCIPAL"
        android:textStyle="bold"
        android:backgroundTint="#6C757D" />

</LinearLayout>